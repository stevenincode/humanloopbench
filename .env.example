# Copy to .env and fill in your values. Never commit .env.

# Ollama Cloud endpoint — get your key at https://ollama.com/settings/keys
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_key_here

# --- Optional: Amazon Bedrock (--provider bedrock) ---
# Credentials come from the standard AWS chain (aws configure / AWS_PROFILE / SSO).
# Do NOT put access keys in this file.
# AWS_REGION=us-east-1
# AWS_PROFILE=humanloopbench
# BEDROCK_MAX_TOKENS=512   # output-token cap per call (cost guard)
